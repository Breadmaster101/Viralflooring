{
  // ============================================================
  //  DISCORD
  // ============================================================
  // Your Discord bot token. Get one at https://discord.com/developers/applications
  "DISCORD_TOKEN": "put your discord bot token here",
  // ============================================================
  //  LLM BACKEND SELECTION
  // ============================================================
  // Which backend to use for message generation.
  // Options: "local" (llama.cpp), "gemini" (Google Gemini API), "openrouter" (OpenRouter API), "cerebras" (Cerebras Inference API), "mistral" (Mistral API)
  "LLM_BACKEND": "mistral",
  // ============================================================
  //  LOCAL BACKEND (llama.cpp / any OpenAI-compatible server)
  // ============================================================
  // Base URL of your local inference server's OpenAI-compatible API
  "LLAMA_BASE_URL": "http://127.0.0.1:8080/v1",
  // API key for the local server (most local servers don't require one)
  "LLAMA_API_KEY": "sk-no-key-required",
  // Model identifier to send in API requests (use "default" for single-model servers)
  "LLAMA_MODEL_ID": "default",
  // ============================================================
  //  GEMINI BACKEND (Google Generative AI)
  // ============================================================
  // Your Google AI Studio / Gemini API key
  "GEMINI_API_KEY": "put your ai studio api key here",
  // Gemini model to use (e.g. "gemini-3.1-flash-lite", "gemma-4-31b-it")
  "GEMINI_MODEL_ID": "gemini-3.1-flash-lite",
  // ============================================================
  //  OPENROUTER BACKEND
  // ============================================================
  // Your OpenRouter API key (get one at https://openrouter.ai/keys)
  "OPENROUTER_API_KEY": "put your openrouter api key here",
  // Model identifier on OpenRouter (e.g. "google/gemma-3-27b-it:free")
  // Browse models at https://openrouter.ai/models
  "OPENROUTER_MODEL_ID": "google/gemma-4-26b-a4b-it:free",
  // ============================================================
  //  CEREBRAS BACKEND
  // ============================================================
  // Your Cerebras API key (get one at https://cloud.cerebras.ai)
  "CEREBRAS_API_KEY": "put your cerebras api key here",
  // Cere,
  // Cerebras model to use
  "CEREBRAS_MODEL_ID": "qwen-3-235b-a22b-instruct-2507",
  // ============================================================
  //  MISTRAL BACKEND
  // ============================================================
  // Your Mistral API key (get one at https://console.mistral.ai)
  "MISTRAL_API_KEY": "put your mistral api key here",
  // Mistral model to use
  "MISTRAL_MODEL_ID": "mistral-medium-3-5",
  // ============================================================
  //  THINKING / REASONING CONTROL
  // ============================================================
  // Set to true to minimize/disable "thinking" tokens on Gemini models.
  // Reduces latency and cost for models that support reasoning effort control.
  "DISABLE_GEMINI_THINKING": true,
  // ============================================================
  //  GENERAL SETTINGS
  // ============================================================
  // Maximum number of tokens of conversation history to include in API requests.
  // Higher = more context but slower and more expensive.
  "MAX_TOKEN_LIMIT": 1000,
  // Path to the SQLite database file that stores conversation history
  "DB_FILE": "history.db",
  // Discord's character limit per message (don't change unless Discord changes it)
  "MAX_DISCORD_MSG_LEN": 2000,
  // Minimum seconds to wait between API calls (prevents rate limiting)
  "API_COOLDOWN_SECONDS": 1.0,
  // Maximum seconds to wait for an LLM response before timing out
  "API_TIMEOUT_SECONDS": 60.0,
  // ============================================================
  //  MEMORY SYSTEM
  // ============================================================
  // Set to true to disable the memory system entirely.
  "DISABLE_MEMORY_SYSTEM": false,
  // Memory scope: "global" (shared across all servers) or "per_server" (separate per guild)
  "MEMORY_SCOPE": "global",
  // Maximum number of memories Viral can store
  "MAX_MEMORIES": 40
}