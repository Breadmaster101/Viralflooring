# ============================================================================
#  Secrets. Copy this file to .env and fill in the values you need.
#  .env is gitignored, so never commit it.
#
#  Only the key for the backend selected in config.toml is required.
#  Real environment variables take priority over this file, so you can also
#  set these in your systemd unit or shell profile instead.
# ============================================================================

# Discord bot token: https://discord.com/developers/applications
DISCORD_TOKEN=

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Mistral: https://console.mistral.ai
MISTRAL_API_KEY=

# Local llama.cpp servers usually need no key; leave the placeholder.
LOCAL_API_KEY=sk-no-key-required
